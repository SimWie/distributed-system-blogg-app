{
  "realm": "blog",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "reader",
        "description": "Eingeloggter Leser: darf Kommentare verfassen"
      },
      {
        "name": "author",
        "description": "Autor: darf Blog-Einträge erstellen und eigene Einträge ändern"
      },
      {
        "name": "admin",
